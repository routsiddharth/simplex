# Simplex ingest — environment surface (FIVE values: four required + one optional).
#
# These are the only runtime *environment* inputs. Everything tunable
# (intervals, depth band, audit thresholds, rate limits, ports, reconnect
# bounds, model ids, confidence cutoffs, log level, ...) is a documented constant
# in
#   src/simplex_ingest/constants.py
# Edit that file to tune behavior; do NOT add knobs here.
#
# Locally: copy to .env and fill in. On Railway: set as service variables.

# Kalshi API key ID (UUID).
KALSHI_API_KEY_ID=

# Kalshi RSA private key (PEM). May be inline multi-line PEM, a \n-escaped
# single line, or a path to a .pem file — the loader normalizes all three.
KALSHI_API_SECRET=

# Which Kalshi environment to hit: demo | prod
KALSHI_ENV=demo

# Directory for the DuckDB file and local state. ./data locally, /data on Railway.
SIMPLEX_DATA_DIR=./data

# OpenRouter API key — the ONLY secret the Stage-3 LLM extraction layer adds.
# Optional: leave empty to run plain ingest (the extraction loop soft-fails and
# idles). Set it to enable per-market semantics + relationship-edge extraction.
# Model ids and all tuning are constants in constants.py, not env.
OPENROUTER_API_KEY=
